# ==========================================
# neo-sf-aozora 設定テンプレート
# ==========================================
# このファイルを .env にコピーして、実際の認証情報を入力してください。
# cp .env.example .env

# --- Google Gemini API 設定 ---
# 海外論文を引用したSFリブート作品の自動執筆に使用します。
# https://aistudio.google.com/app/apikey で取得できます。
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash

# --- SMTP 送信サーバー設定 ---
# Gmailを使用する場合:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   ※Googleアカウントの「2段階認証」を有効にし、「アプリパスワード」を発行して設定してください。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# 送信者名（表示名）
MAIL_FROM_NAME=SF Auto Publisher

# --- WordPress メール投稿 受信設定 ---
# Jetpackの「メールによる投稿」で発行された専用アドレス、
# または Postie / Mail2Post 等で設定した受信用メールアドレスを指定します。
# 例: secret_key_12345@post.wordpress.com
WP_POST_EMAIL=your_wordpress_post_email@post.wordpress.com

# --- 投稿オプション（初期値） ---
# publish (公開) または draft (下書き)
DEFAULT_POST_STATUS=publish

# Jetpackショートコードの付加（[category ...], [tags ...], [status ...]）
USE_JETPACK_SHORTCODES=true
