# ==========================================
# neo-sf-aozora 設定テンプレート
# ==========================================
# このファイルを .env にコピーして、実際の認証情報を入力してください。
# cp .env.example .env

# --- Google Gemini API 設定 ---
# 海外論文を引用したSFリブート作品の自動執筆に使用します。
# https://aistudio.google.com/app/apikey で取得できます。
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash

# --- SMTP 送信サーバー設定 ---
# Gmailを使用する場合:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   ※Googleアカウントの「2段階認証」を有効にし、「アプリパスワード」を発行して設定してください。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# 送信者名（表示名）
MAIL_FROM_NAME=SF Auto Publisher

# --- WordPress メール投稿 受信設定 ---
# Jetpackの「メールによる投稿」で発行された専用アドレス、
# または Postie / Mail2Post 等で設定した受信用メールアドレスを指定します。
# 例: secret_key_12345@post.wordpress.com
WP_POST_EMAIL=your_wordpress_post_email@post.wordpress.com

# --- Google Blogger メール投稿 受信設定 ---
# Blogger管理画面「設定」→「メール」→「メールを使用して投稿する」で設定した専用アドレスを指定します。
# 設定すると、WordPressへのメール投稿と同時にBloggerへも自動メール投稿されます（Jetpack用ショートコードは自動除去されます）。
# 例: username.secret_words@blogger.com
BLOGGER_POST_EMAIL=your_username.secret_words@blogger.com

# --- 投稿オプション（初期値） ---
# publish (公開) または draft (下書き)
DEFAULT_POST_STATUS=publish

# Jetpackショートコードの付加（[category ...], [tags ...], [status ...]）
USE_JETPACK_SHORTCODES=true

# --- X (旧Twitter) 同時ポスト設定 ---
# WordPress投稿と同時にXへ「原典作品名」と「SFリブートの視点」を自動ポストします。
# X Developer Portal (https://developer.x.com/) で取得した OAuth 1.0a (Read and Write) キーを設定してください。
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# （任意）ブログURLをXのポスト末尾に付与する場合に設定
WP_SITE_URL=

# （任意）IFTTT / Make / Zapier 等のWebhook経由でXにポストする場合に設定
X_WEBHOOK_URL=

